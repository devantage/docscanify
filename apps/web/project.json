{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": ["scope:app"],
  "targets": {
    "lint": {
      "cache": false,
      "options": {
        "args": ["--fix"]
      }
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc -p apps/web/tsconfig.app.json --noEmit && tsc -p apps/web/tsconfig.node.json --noEmit"
      },
      "executor": "nx:run-commands"
    }
  }
}
