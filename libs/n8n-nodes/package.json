{
  "name": "@devantage/n8n-nodes-docscanify",
  "version": "1.0.0",
  "description": "n8n community nodes that scan and crop documents out of images (edge detection and perspective correction) and output them as images or PDFs",
  "contributors": [
    "Guilherme Nogueira <guilherme.nogueira@devantage.com.br>"
  ],
  "homepage": "https://github.com/devantage/docscanify",
  "repository": {
    "type": "git",
    "url": "https://github.com/devantage/docscanify.git",
    "directory": "libs/n8n-nodes"
  },
  "keywords": [
    "n8n-community-node-package",
    "scanner",
    "pdf",
    "camscanner",
    "opencv"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "icons"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "src/nodes/DocScanify.node.js"
    ]
  },
  "dependencies": {
    "@devantage/docscanify": "^1.0.0",
    "@devantage/n8n-custom-nodes-framework": "^1.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
