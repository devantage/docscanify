    "test": "nx test",
    "test:all": "nx run-many -t test"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@techstark/opencv-js": "4.7.0-release.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@nx/jest": "24.0.4",
    "@nx/js": "24.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.6.0",
    "nx": "24.0.4",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
