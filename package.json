{
  "name": "@devantage/docscanify",
  "version": "1.0.0",
  "description": "Detect, crop and correct the perspective of documents in images on Node.js and browsers, with no install scripts and no system dependencies",
  "contributors": [
    "Guilherme Nogueira <guilherme.nogueira@devantage.com.br>"
  ],
  "homepage": "https://github.com/devantage/docscanify",
  "repository": {
    "type": "git",
    "url": "https://github.com/devantage/docscanify.git"
  },
  "keywords": [
    "document-scanner",
    "scanner",
    "perspective-correction",
    "edge-detection",
    "opencv",
    "jscanify"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": {
    "@napi-rs/canvas": false,
    "@techstark/opencv-js": false
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "clean": "rimraf dist",
    "build:compile": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run build:compile",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint --fix \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@techstark/opencv-js": "4.7.0-release.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "npm run lint",
      "npm run test -- --findRelatedTests --passWithNoTests"
    ]
  }
}
